{
  "description": "Project delegation watcher lifecycle; set the chosen project path before enabling.",
  "hooks": {
    "SessionStart": [{
      "matcher": "^(startup|resume)$",
      "hooks": [{
        "type": "command",
        "command": "python3 ${HOME}/.codex/skills/project-delegation/scripts/session_watch_hook.py --project /absolute/path/to/project",
        "timeout": 3
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "python3 ${HOME}/.codex/skills/project-delegation/scripts/session_watch_hook.py --project /absolute/path/to/project",
        "timeout": 3
      }]
    }]
  }
}
